# ============================================================
# LISA Challenge 2026 — .gitignore
# ============================================================

# ─── Datos del challenge (pesados / privados) ───────────────
data/
nnunet_workspace/

# ─── Notebooks de descarga ─────────────────────────────────
download_data.ipynb

# ─── PDFs externos ─────────────────────────────────────────
# *.pdf

# ─── Herramienta IA ────────────────────────────────────────
.claude/

# ─── Checkpoints y modelos entrenados ──────────────────────────────
task_1a/checkpoints/
task_1b/checkpoints/
*.pth
*.pt
*.ckpt
*.h5

# ─── Paper y versiones antiguas (no son código fuente) ────────────
task_1a/paper/
task_1a/archive/
task_1b/paper/

# ─── PDFs en docs/ ─────────────────────────────────────────
docs/*.pdf

# ─── Archivos de submission generados (solo raíz — lisatask1aresults/ se conserva) ──
/LISA_LF_QC_predictions.csv
/LISA_LF_QC_predictions_*.csv
/LISA_LF_QC_predictions[0-9]*.csv
submission_task1a*.csv

# ─── Predicciones/backups pesados (van al paquete de datos crudos, no a git) ──
# Superan incluso el límite de 100 MB por archivo de GitHub.
/LISA_enhanced_predictions*.zip
task_1b/*.zip
task_2/paper_task2.zip
/9768080_logs.txt
task_1b/9768080_logs.txt

# ─── Paper con identidad de autores (solo para revisión ciega ya superada) ──
# El paper final que se envió a revisión es la versión anónima
# (paper_combined/paper.tex, paper.pdf, LISA2026_submission11_syn75277286.pdf).
# Estos otros archivos identifican a los autores y no van al repo mientras
# el equipo no decida explícitamente publicarlos.
paper_combined/LISA2026_Marca_et_al.pdf
paper_combined/LISA2026_Marca_et_al_source.zip
task_2/paper_task2/

# ─── Artefactos de compilación LaTeX ────────────────────────────
*.aux
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.bbl
*.blg

# ─── Python ────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# ─── Cache .npy (pre-procesamiento de datos) ───────────────────
# Generado por preprocess_to_npy.py — no subir al repo (binarios grandes)
task_1b/npy_cache/

# ─── Predicciones NIfTI de Task 1b sin comprimir (~1.36 GB) ────────
# Mismas variantes descartadas que los .zip de la raíz, solo que
# extraídas — van al paquete de datos crudos del equipo, no a git.
task_1b/submission/

# ─── Cache de registro CISO↔LF (417 MB, deriva de imágenes de Synapse) ──
task_1b/reg_cache/
*.egg
dist/
build/
.eggs/

# ─── Entornos virtuales ────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Jupyter ───────────────────────────────────────────────
.ipynb_checkpoints/

# ─── IDEs ──────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ─── Sistema operativo ─────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs y temporales ─────────────────────────────────────
*.log
*.tmp
*.bak

# ─── Material de revisión con texto verbatim de los revisores ──────
# El equipo decidió no publicar las reseñas literales en un repo público.
# Viven sólo en el paquete local del equipo. Lo que sí se publica es la
# carta de respuesta (RESPONSE_TO_REVIEWERS.md) y las versiones revisada
# y con cambios marcados del manuscrito.
paper_combined/REVIEWS_LISA2026.md
paper_combined/analysis/review_map.py
paper_combined/paper_interactive.*
